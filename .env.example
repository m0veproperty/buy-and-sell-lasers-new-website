# Optional local overrides.
# MARKETPLACE_DB_PATH=work/backend/marketplace.sqlite
# APP_ORIGIN=http://127.0.0.1:3000

# Hosted libSQL (required on Vercel). The Turso integration supplies
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN, or set both overrides below.
# MARKETPLACE_DATABASE_URL=libsql://your-database.example
# MARKETPLACE_DATABASE_TOKEN=

# PayPal sandbox and publication email. Set secrets through server-side configuration.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_ID=
# PAYPAL_WEBHOOK_ID=
# RESEND_API_KEY=
# MARKETPLACE_EMAIL_FROM=
# MARKETPLACE_NOTIFICATION_SECRET=
